# ==============================================================================
# AI REVENUE RECOVERY SYSTEM CONFIGURATION
# ==============================================================================

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=change_me_to_a_secure_random_string_in_production

# Database Configuration
# Default is SQLite for fast local development and zero-config deployment.
# For PostgreSQL: postgresql+asyncpg://postgres:postgres@localhost:5432/revenue_recovery
DATABASE_URL=sqlite+aiosqlite:///./revenue_recovery.db

# Redis Cache & Queue (Optional in dev, falls back to in-memory)
REDIS_URL=redis://localhost:6379/0

# LLM Configuration (LangChain / LangGraph)
# Fallback deterministic rule-based reasoning will engage if OPENAI_API_KEY is not provided.
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2

# Payment Gateway API Keys (Leave blank to use mock/sandbox dispatchers)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
CHARGEBEE_API_KEY=

# Communication Service Credentials (Leave blank to use mock/sandbox dispatchers)
SENDGRID_API_KEY=
RESEND_API_KEY=
FROM_EMAIL=billing@yourcompany.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
VAPI_API_KEY=
VAPI_ASSISTANT_ID=

# Compliance Guardrails Defaults
MAX_CONTACT_ATTEMPTS_PER_WEEK=3
ENABLE_DISPUTE_KILLSWITCH=true
ENABLE_QUIET_HOURS=true
QUIET_HOURS_START_UTC=22
QUIET_HOURS_END_UTC=7
HIGH_VALUE_THRESHOLD_USD=5000.00
PROMISE_TO_PAY_GRACE_DAYS=3
